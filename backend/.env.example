# ─────────────────────────────────────────────────────────────────────────────
# Solana Memecoin Trader — Environment Configuration
# Copy this file to .env and fill in your values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
HOST=127.0.0.1
API_KEY=change-this-to-a-random-secret-string

# ── Wallet (CRITICAL – local signing only, never leave this machine) ──────────
# Your trading wallet private key in base58 format.
# IMPORTANT: Use a dedicated hot wallet with ONLY the capital you intend to trade.
# Never use your main wallet.
WALLET_PRIVATE_KEY=your_base58_private_key_here

# ── Solana RPC (faster RPC = faster execution = better results) ──────────────
# Comma-separated list of RPC endpoints (rotated on failure).
# Recommended: Helius, QuickNode, Triton, or Alchemy private RPCs.
RPC_ENDPOINTS=https://api.mainnet-beta.solana.com
WS_ENDPOINT=wss://api.mainnet-beta.solana.com

# Private RPC services (fill at least one for production use):
HELIUS_API_KEY=
QUICKNODE_ENDPOINT=

# Transaction priority fee in micro-lamports (higher = faster inclusion)
# 100000 = 0.0001 SOL per tx — adjust based on network congestion
PRIORITY_FEE=100000

# ── Trading Parameters ───────────────────────────────────────────────────────
# Fraction of wallet balance per trade (0.01–0.03 = 1%–3%)
TRADE_CAPITAL_PCT=0.02
# Limites min/max para o tamanho do trade (pode expandir para carteiras pequenas)
MIN_TRADE_CAPITAL_PCT=0.01
MAX_TRADE_CAPITAL_PCT=0.30

# Minimum token score (0–100) required before buying
MIN_SCORE=72

# Delay after token launch before entering (milliseconds)
SNIPER_DELAY_MIN=10000
SNIPER_DELAY_MAX=30000

# Slippage tolerance in basis points (100 = 1%, 300 = 3%)
SLIPPAGE_BPS=300

# Stop loss percentage below entry (0.20 = 20% stop loss)
STOP_LOSS_PCT=0.20

# Trailing stop: activate at +30% gain, trail by 15%
TRAILING_ACTIVATE=0.30
TRAILING_STOP_PCT=0.15

# Maximum simultaneous open positions
MAX_POSITIONS=5

# Maximum token age to consider sniping (seconds)
MAX_TOKEN_AGE=120

# Set to true to paper trade (no real transactions)
SIMULATE=false

# ── Risk Management ───────────────────────────────────────────────────────────
# Daily loss limit as fraction of starting balance (0.05 = 5%)
MAX_DAILY_LOSS_PCT=0.05

# Number of consecutive losses before auto-halt
MAX_CONSECUTIVE_LOSSES=4

# Hours to pause trading after hitting loss limit
PAUSE_HOURS=4

# ── Token Filters (minimum requirements to even consider a token) ─────────────
MIN_LIQUIDITY_USD=15000
MIN_HOLDERS=50
MAX_TOP10_PCT=0.50
MAX_DEV_PCT=0.10
MIN_LOCKED_LIQ=0.70
REQUIRE_MINT_RENOUNCED=true
REQUIRE_FREEZE_RENOUNCED=true

# Comma-separated blacklisted deployer addresses
BLACKLIST_DEPLOYERS=

# Comma-separated blacklisted contract addresses
BLACKLIST_CONTRACTS=

# ── Social / AI Hype Layer ────────────────────────────────────────────────────
# Twitter API v2 Bearer Token (get from developer.twitter.com — Free tier only)
# NOTE: Filtered stream requires paid Basic plan ($100/mo) — NOT used.
# Only KOL polling (/2/users/{id}/tweets) is used — compatible with Free tier.
TWITTER_BEARER_TOKEN=

# Twitter KOL handles to monitor (comma-separated, without @)
# These accounts are polled every 30s for token calls.
# Ex: ansemMKT,cryptocobain,blknoiz06,inversebrah
KOL_HANDLES=

# Telegram bot token (create via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=

# Telegram channel/group IDs for GENERAL social monitoring (comma-separated)
# Ex: -1001234567890,-1009876543210
TELEGRAM_CHANNELS=

# Telegram channel/group IDs for ALPHA/CALL monitoring (fast 500ms polling)
# These channels post contract addresses and token calls.
# Leave empty to use same as TELEGRAM_CHANNELS, or use ALL channels if both empty.
# Ex: -1001234567890,@solanaalpha
TELEGRAM_ALPHA_CHANNELS=

# Minimum mention growth rate (mentions per minute) to register as hype
MIN_MENTION_GROWTH=5

# Weight of sentiment in hype scoring (0–1)
SENTIMENT_WEIGHT=0.25

# ── Smart Money Tracker ───────────────────────────────────────────────────────
# Comma-separated base58 addresses of known profitable on-chain traders to monitor.
# When 1+ of these wallets buy a new SPL token, the bot receives a trading signal.
# The more wallets that buy the same token, the higher the signal confidence.
# Example: SMART_WALLETS=WaLLeT1xXxXxXxXxXxX,WaLLeT2xXxXxXxXxXxX
SMART_WALLETS=

# ── Copy Trading ──────────────────────────────────────────────────────────────
COPY_TRADING_ENABLED=false

# Wallets to mirror (comma-separated base58 addresses of profitable traders)
COPY_WALLETS=

# Minimum win rate to follow a wallet (0.60 = 60%)
COPY_MIN_WIN_RATE=0.60

# Max delay after detected wallet tx (ms)
COPY_MAX_DELAY_MS=5000

# ── DEX Endpoints ────────────────────────────────────────────────────────────
JUPITER_API_URL=https://quote-api.jup.ag/v6
RAYDIUM_API_URL=https://api.raydium.io/v2

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=./data/trading.db

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs
